# ---- DagsHub / MLflow (training only) ----
ROLL_NUMBER=00F-0000
MLFLOW_TRACKING_URI=https://dagshub.com/<user>/<ROLL>_A2_Ops.mlflow
MLFLOW_TRACKING_USERNAME=<dagshub-username>
MLFLOW_TRACKING_PASSWORD=<dagshub-token>

# ---- Flask UI ----
SECRET_KEY=change-me
MAX_UPLOAD_MB=5
THRESHOLD=0.29
INFERENCE_API_URL=http://<cloud-ip>:8000/predict
INFERENCE_API_KEY=change-me-too
POSTGRES_USER=visionguard
POSTGRES_PASSWORD=change-me
POSTGRES_DB=visionguard
DATABASE_URL=postgresql+psycopg2://visionguard:change-me@db:5432/visionguard

# ---- Model API (cloud) ----
MODEL_PATH=/app/models/champion.keras
MODEL_NAME=visionguard-champion
MODEL_VERSION=2
IMG_SIZE=224
